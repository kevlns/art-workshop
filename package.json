{
  "name": "@kevlns/art-workshop",
  "version": "0.5.0",
  "private": false,
  "description": "管理项目风格、参考图、图片生成、编辑和定版。支持本地 ComfyUI 与远程图片模型。",
  "type": "module",
  "bin": {
    "art-workshop": "art-workshop.mjs"
  },
  "files": [
    "art-workshop.mjs",
    "lib/",
    "rules/",
    "skills/",
    "scripts/sync-skill.mjs",
    "README.md",
    "LICENSE",
    "v-cli.plugin.json",
    "AGENTS.md",
    "workflows/",
    "docs/"
  ],
  "scripts": {
    "postinstall": "node scripts/sync-skill.mjs",
    "skill:sync": "node scripts/sync-skill.mjs",
    "test": "node scripts/test.mjs",
    "pack:guard": "node scripts/pack-guard.mjs",
    "check": "npm run docs:style && npm run docs:check && npm test && npm run pack:guard",
    "test:package": "node scripts/test-package-install.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:generate": "node scripts/command-docs.mjs",
    "docs:style": "node scripts/check-documentation.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevlns/art-workshop.git"
  },
  "homepage": "https://github.com/kevlns/art-workshop#readme",
  "bugs": {
    "url": "https://github.com/kevlns/art-workshop/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Vant",
  "vCli": {
    "manifest": "v-cli.plugin.json"
  },
  "dependencies": {
    "bailian-cli": "2.2.1",
    "bailian-cli-core": "2.2.1",
    "sharp": "^0.35.5"
  }
}
